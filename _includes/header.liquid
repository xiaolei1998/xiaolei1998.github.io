{% assign contact_email = site.data.socials.email | replace: 'DOT', '.' | replace: 'AT', '@' %}
<header class="site-header" role="banner">
  <div class="site-identity">
    <a class="site-name" href="{{ '/' | relative_url }}">{{ site.first_name }} {{ site.last_name }}</a>
    <p class="site-tagline">Ph.D. Student · Human-Centred Sensing &amp; AI4Health</p>
  </div>

  <nav class="site-nav" aria-label="Primary navigation">
    <a class="{% if page.url == '/' %}is-active{% endif %}" href="{{ '/' | relative_url }}">Home</a>
    <a class="{% if page.url contains '/projects/' %}is-active{% endif %}" href="{{ '/projects/' | relative_url }}">Portfolio</a>
    <a class="{% if page.url contains '/cv/' %}is-active{% endif %}" href="{{ '/cv/' | relative_url }}">CV</a>
    <a class="{% if page.url contains '/news/' %}is-active{% endif %}" href="{{ '/news/' | relative_url }}">News</a>
    <a href="mailto:{{ contact_email }}">Contact</a>
  </nav>
</header>
